#!/usr/bin/env python3
"""
Lino Research Assistant (LRA)
Genera note di ricerca strutturate a partire da risultati di search + fetch.

Input:  JSON con {"query": "...", "sources": [{"title": "...", "url": "...", "type": "...", "content": "..."}]}
Output: markdown strutturato in /work/lra/output/

Solo Python standard library: nessuna dipendenza esterna.
"""

import json
import sys
import os
import re
import math
from collections import Counter
from datetime import date

# Stop words (italiano + inglese) per l'estrazione di keyword
STOP_WORDS = set("""
il lo la i gli le un uno una di del dello della dei degli delle a ad al allo alla ai agli alle
da dal dallo dalla dai dagli dalle in nel nello nella nei negli nelle con su sul sullo sulla sui sugli sulle
per tra fra e o ma che chi cui non è sono era ero sei se più come cosa questo questa questi queste quello quella
quelli quelle ho hai ha abbiamo avete hanno si ci vi ti mi ne lo gli le mio mia miei mie tuo tua tuoi tue suo sua
suoi sue nostro nostra nostri nostre vostro vostra vostri vostre loro essere avere fare dire fare stato stata stati
stesse stesso stessa stessi molto tanto poco anche ancora già sempre mai ogni tutto tutta tutti tutte solo soltanto
dove quando perché quindi però infatti inoltre mentre dopo prima durante contro verso tra
the a an and or but if then else of to in on for with is are was were be been being have has had do does did will
would could should may might must shall can need dare ought used this that these those it its as at by from than
into over under again further once other some such no nor not only own same so too very s t just don now
also about into out up down after before between because while during against through between
""".split())



# Parole generiche escluse dai temi (oltre alle stop words)
GENERIC_WORDS = set("""
you your we they them their ours yours mine me him her his its our my yours ours this these those
what when where why how who whom which that these those some any all both each few more most other
such no nor not only own same so too very just now then here there one two three first last new old
big small good great better best bad worse worst high low long short hot cold fast slow easy hard
simple complex free paid premium basic pro enterprise startup company business work home free
website audit trends blog search explore tools connect pricing agency freelancing
https http www html href amp nbsp quot egrave agrave ograve igrave ugrave eacute
""".split())


def tokenize(text: str) -> list:
    """Estrae parole (solo lettere, minuscole, lunghezza >= 3) dal testo."""
    words = re.findall(r"[a-zA-Zà-ùÀ-Ù]{3,}", text.lower())
    return [w for w in words if w not in STOP_WORDS]


def extract_keywords(text: str, n: int = 5) -> list:
    """Restituisce le n parole più frequenti (con conteggio)."""
    counter = Counter(tokenize(text))
    return counter.most_common(n)


def common_keywords(sources: list, n: int = 10) -> list:
    """Parole chiave presenti in almeno 2 fonti, ordinate per frequenza totale.
    Esclude stop words e parole generiche (you, what, your, ecc.)."""
    if len(sources) < 2:
        return []
    total = Counter()
    per_source = []
    for s in sources:
        c = Counter(tokenize(s.get("content", "")))
        per_source.append(c)
        total.update(c)
    common = []
    for word, freq in total.most_common():
        if word in GENERIC_WORDS or len(word) < 4:
            continue
        count_in_sources = sum(1 for c in per_source if c.get(word, 0) > 0)
        if count_in_sources >= 2:
            common.append((word, freq))
    return common[:n]


def find_contradictions(sources: list) -> list:
    """Cerca potenziali contraddizioni: frasi con connettivi avversativi."""
    markers = ["non", "ma", "tuttavia", "però", "invece", "however", "nevertheless",
               "on the other hand", "conversely", "but", "although", "yet"]
    found = []
    for s in sources:
        content = s.get("content", "")
        sentences = re.split(r"(?<=[.!?])\s+", content)
        for sent in sentences:
            low = sent.lower()
            if any(m in low for m in markers) and len(sent) > 40:
                found.append((s.get("title", "Fonte"), sent.strip()[:200]))
    return found


def find_contradictions_v2(sources: list) -> list:
    """Versione migliorata: cerca affermazioni numericamente opposte o in conflitto."""
    found = []
    # Cerca frasi con numeri seguiti da unità di misura diverse
    number_pattern = re.compile(r'([$€£]?\s*\d+[.,]?\d*\s*(?:mille|milioni|billion|million|k|m|%)?)', re.IGNORECASE)
    
    numbers_by_source = []
    for s in sources:
        nums = number_pattern.findall(s.get("content", ""))
        numbers_by_source.append((s.get("title", "Fonte"), nums[:10]))
    
    # Confronta tra fonti: se una fonte dice "costa $X" e un'altra "costa $Y" con X != Y
    for i in range(len(sources)):
        for j in range(i + 1, len(sources)):
            nums_i = [n.lower().strip() for n in numbers_by_source[i][1]]
            nums_j = [n.lower().strip() for n in numbers_by_source[j][1]]
            # Cerca numeri che appaiono in una fonte ma non nell'altra (potenziale divergenza)
            unique_i = [n for n in nums_i if n not in nums_j and len(n) > 1]
            unique_j = [n for n in nums_j if n not in nums_i and len(n) > 1]
            if unique_i and unique_j:
                found.append((
                    f"{numbers_by_source[i][0]} vs {numbers_by_source[j][0]}",
                    f"Differenze numeriche: {numbers_by_source[i][0]} menziona {unique_i[:3]}, "
                    f"{numbers_by_source[j][0]} menziona {unique_j[:3]}"
                ))
    return found

def generate_open_questions(sources: list, keywords: list, query: str) -> list:
    """Genera domande aperte basate su keyword e gap tra fonti."""
    questions = []
    kw = [k[0] for k in keywords]
    if len(kw) >= 2:
        questions.append(f"- Come si relaziona **{kw[0]}** a **{kw[1]}** nel contesto di \"{query}\"?")
    if len(kw) >= 3:
        questions.append(f"- Qual è il ruolo di **{kw[2]}** rispetto a **{kw[0]}**?")
    questions.append(f"- Quali sono le limitazioni principali emerse dalle fonti su \"{query}\"?")
    questions.append("- Cosa ne pensa la comunità (forum, GitHub, social) rispetto a queste conclusioni?")
    if len(sources) > 1:
        questions.append("- Ci sono aspetti su cui le fonti divergono o si contraddicono?")
    return questions


def clean_content_lines(text: str) -> str:
    """Rimuove righe di boilerplate (menu, header, URL, email, telefoni) dal testo."""
    lines = text.split('\n')

    menu_words = ['services','work','case studies','pricing','about','blog','contact','home',
                  'hire us','general','location','follow for updates','startups','tl;dr',
                  'back to','navigation','toggle','cookie','privacy','terms','subscribe',
                  'share','search','menu','login','signup','register','sign in','sign up',
                  'all rights','read in app','privacy policy','terms of service']

    cleaned = []
    for line in lines:
        s = line.strip()
        if not s:
            continue
        if re.match(r'^https?://', s, re.I):
            continue
        if re.match(r'^(Source|Fetched|Written by|Published|Updated|Tags|Categories):', s, re.I):
            continue
        if re.match(r'^[-*|#=$^&*(){}[\]<>!?;:,.@#\$]+$', s):
            continue
        if re.match(r'^[\d\-\s/:]+$', s):
            continue
        if re.match(r'^\|\s*$', s):
            continue
        cleaned.append(s)

    result = []
    i = 0
    while i < len(cleaned):
        s = cleaned[i]
        is_short = len(s) < 35
        has_menu_word = any(w in s.lower() for w in menu_words)
        is_markdown = bool(re.match(r'^#{1,6}\s', s))
        is_bullet = bool(re.match(r'^[-*]\s', s))

        if (is_short or is_markdown) and (has_menu_word or is_bullet):
            j = i + 1
            while j < len(cleaned) and len(cleaned[j]) < 60:
                j += 1
            i = j
            continue
        if is_markdown and len(s) < 50:
            i += 1
            continue
        if '@' in s and len(s) < 60:
            i += 1
            continue
        if re.match(r'^[\+]?[\d\s\(\)]{7,}$', s):
            i += 1
            continue
        if re.search(r'\d+\s+(via|viale|corso|piazza|strada|borgo)\b', s, re.I) and len(s) < 80:
            i += 1
            continue
        result.append(s)
        i += 1

    return ' '.join(result)


def smart_split_sentences(text: str) -> list:
    """Split intelligente per punteggiatura dopo aver pulito il testo."""
    clean = clean_content_lines(text)
    sentences = re.split(r'(?<=[.!?;:])\s+(?=[A-Za-z0-9\$€£\d])', clean)
    return [s.strip() for s in sentences if s.strip()]


def extract_key_sentences(content: str, n: int = 3) -> list:
    """Estrae le frasi piu informative usando TF-IDF (parole rare = punteggio alto).
    Pulisce prima il testo da boilerplate (menu, header, URL, email, telefoni)."""
    sentences = smart_split_sentences(content)
    sentences = [s.strip() for s in sentences if len(s.strip()) >= 40]
    if not sentences:
        return []
    
    # TF-IDF: misura quanto ogni parola è rara nel testo
    tf_list = []
    for s in sentences:
        words = re.findall(r'[a-zA-Zà-ùÀ-Ù]{3,}', s.lower())
        c = Counter(words)
        total = len(words) or 1
        tf_list.append({w: count/total for w, count in c.items()})
    
    df = Counter()
    for t in tf_list:
        for w in t:
            df[w] += 1
    
    N = len(sentences)
    idf = {w: math.log(N / (count + 1)) for w, count in df.items()}
    
    scored = []
    for i, s in enumerate(sentences):
        tfidf_score = sum(tf_list[i][w] * idf.get(w, 0) for w in tf_list[i])
        # Bonus per frasi con numeri o termini di business
        if re.search(r'\d', s):
            tfidf_score += 0.5
        if any(w in s.lower() for w in ['cost', 'price', 'prezzo', 'revenue', 'ricavo', 'margin', 'margine',
                                         'model', 'models', 'modelli', 'business', 'client', 'customers',
                                         'growth', 'crescita', 'market', 'mercato', 'automation', 'automazione']):
            tfidf_score += 0.3
        scored.append((tfidf_score, s))
    
    scored.sort(reverse=True)
    return [s for _, s in scored[:n]]


def generate_summary(sources: list, query: str) -> str:
    """Genera un riassunto strutturato e tematico dai contenuti.
    
    Migliorato: identifica automaticamente i temi principali (keyword comuni a piu fonti)
    e raggruppa le frasi per tema invece di mostrarle in lista piatta.
    """
    lines = []
    lines.append(f"### Sintesi su \"{query}\"")
    lines.append("")
    
    if not sources:
        lines.append("_(nessuna fonte disponibile)_")
        return "\n".join(lines)
    
    # Raccogli tutte le frasi pulite con attribuzione
    all_sentences = []
    for s in sources:
        title = s.get("title", "Fonte")
        content = s.get("content", "")
        sentences = smart_split_sentences(content)
        for sent in sentences:
            if len(sent) >= 40:
                all_sentences.append((title, sent))
    
    if not all_sentences:
        lines.append("_(contenuti insufficienti per un riassunto)_")
        return "\n".join(lines)
    
    # TF-IDF: seleziona le frasi piu informative (parole rare = punteggio alto)
    all_text = " ".join(s.get("content", "") for s in sources)
    tfidf_sentences = extract_key_sentences(all_text, n=12)
    # Mantieni solo le frasi che sono anche in all_sentences (per attribuzione)
    tfidf_set = set(s.strip().lower()[:80] for s in tfidf_sentences)
    scored_sentences = []
    for title, sent in all_sentences:
        if sent.strip().lower()[:80] in tfidf_set:
            scored_sentences.append((title, sent))
    if not scored_sentences:
        scored_sentences = all_sentences[:12]  # fallback
    
    # Identifica i temi principali: keyword presenti in almeno 2 fonti
    theme_keywords = common_keywords(sources, n=8)
    
    if len(sources) >= 2 and theme_keywords:
        # Raggruppa le frasi per tema
        themes = {}
        for keyword, freq in theme_keywords:
            theme_sentences = []
            for title, sent in all_sentences:
                if keyword.lower() in sent.lower():
                    theme_sentences.append((title, sent))
            if theme_sentences:
                seen = set()
                unique = []
                for t, s in theme_sentences:
                    if t not in seen:
                        unique.append((t, s))
                        seen.add(t)
                themes[keyword] = unique[:3]
        
        theme_order = sorted(themes.keys(),
                           key=lambda k: len(set(t for t, _ in themes[k])),
                           reverse=True)
        
        for theme in theme_order[:4]:
            theme_sents = themes[theme]
            fonti_coperte = len(set(t for t, _ in theme_sents))
            lines.append(f"**Tema: {theme.capitalize()}** _(menzione in {fonti_coperte} fonti)_")
            lines.append("")
            for title, sent in theme_sents[:2]:
                display = sent[:250] + "..." if len(sent) > 250 else sent
                lines.append(f"> *{title}*: {display}")
                lines.append("")
    else:
        seen_titles = set()
        for title, sent in scored_sentences[:6]:
            if title not in seen_titles:
                lines.append(f"> **{title}**: {sent[:200]}")
                lines.append("")
                seen_titles.add(title)
    
    total_chars = sum(len(s.get('content', '')) for s in sources)
    lines.append(f"**In sintesi**: {len(sources)} fonti analizzate, {total_chars} caratteri totali. "
                 f"{len(all_sentences)} frasi estratte, {len(theme_keywords)} temi principali identificati.")
    return "\n".join(lines)


def build_note(data: dict, n_keywords: int = 5, compare: bool = False) -> str:
    query = data.get("query", "Senza titolo")
    sources = data.get("sources", [])
    today = date.today().isoformat()
    total_chars = sum(len(s.get("content", "")) for s in sources)

    lines = []
    lines.append(f"# Ricerca: {query}")
    lines.append("")
    lines.append(f"_Generato il {today} da Lino Research Assistant_")
    lines.append("")

    # Riassunto
    lines.append("## Riassunto")
    lines.append("")
    if data.get("summary"):
        lines.append(data["summary"])
    else:
        summary_text = generate_summary(sources, query)
        lines.append(summary_text)
    lines.append("")

    # Punti chiave
    lines.append("## Punti chiave")
    lines.append("")
    for s in sources:
        title = s.get("title", "Senza titolo")
        content = s.get("content", "")
        key = content[:150].replace("\n", " ").strip()
        lines.append(f"- **{title}**: {key}")
    lines.append("")

    # Dettaglio per fonte
    lines.append("## Dettaglio per fonte")
    lines.append("")
    for i, s in enumerate(sources, 1):
        title = s.get("title", f"Fonte {i}")
        url = s.get("url", "")
        stype = s.get("type", "Pagina web")
        content = s.get("content", "")
        clean = content[:500].replace("\n", " ").replace("|", "\\|")
        lines.append(f"### {i}. {title}")
        lines.append("")
        lines.append(f"- **URL**: {url}")
        lines.append(f"- **Tipo**: {stype}")
        lines.append(f"- **Contenuto**: {clean}")
        lines.append("")

    # Confronto tra fonti (opzionale)
    contradictions = []
    if compare and len(sources) >= 2:
        common = common_keywords(sources)
        contradictions = find_contradictions_v2(sources)
        lines.append("## Confronto tra fonti")
        lines.append("")
        lines.append("### Parole chiave comuni")
        lines.append("")
        if common:
            lines.append(", ".join(f"**{w}** ({f})" for w, f in common))
        else:
            lines.append("_(nessuna parola chiave condivisa rilevata)_")
        lines.append("")
        if contradictions:
            lines.append("### Potenziali contraddizioni")
            lines.append("")
            for title, sent in contradictions:
                lines.append(f"- **{title}**: \"{sent}...\"")
            lines.append("")
    else:
        common = common_keywords(sources)

    # Domande aperte
    lines.append("## Domande aperte")
    lines.append("")
    questions = generate_open_questions(sources, common, query)
    lines.extend(questions)
    lines.append("")

    # Statistiche
    lines.append("## Statistiche")
    lines.append("")
    lines.append(f"- Numero di fonti: {len(sources)}")
    lines.append(f"- Caratteri totali processati: {total_chars}")
    lines.append(f"- Data di generazione: {today}")
    if common:
        top = ", ".join(f"{w} ({f})" for w, f in common[:10])
        lines.append(f"- Keyword più frequenti: {top}")
    lines.append("")

    # Fonti
    lines.append("## Fonti")
    lines.append("")
    for i, s in enumerate(sources, 1):
        title = s.get("title", f"Fonte {i}")
        url = s.get("url", "")
        lines.append(f"{i}. [{title}]({url})")
    lines.append("")

    return "\n".join(lines)


def parse_args(argv):
    args = {"input": None, "output": None, "keywords": 5, "compare": False}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--input" and i + 1 < len(argv):
            args["input"] = argv[i + 1]; i += 2
        elif a == "--output" and i + 1 < len(argv):
            args["output"] = argv[i + 1]; i += 2
        elif a == "--keywords" and i + 1 < len(argv):
            try:
                args["keywords"] = int(argv[i + 1])
            except ValueError:
                pass
            i += 2
        elif a == "--compare":
            args["compare"] = True; i += 1
        else:
            i += 1
    return args


def main():
    args = parse_args(sys.argv[1:])

    if not args["input"]:
        # Retrocompatibilità: primo argomento posizionale = input
        if len(sys.argv) >= 2 and not sys.argv[1].startswith("--"):
            args["input"] = sys.argv[1]
            if len(sys.argv) >= 3:
                args["output"] = sys.argv[2]
        else:
            print("Uso: lra.py --input <input.json> [--output <output.md>] [--keywords <n>] [--compare]",
                  file=sys.stderr)
            sys.exit(1)

    input_path = args["input"]
    output_path = args["output"] or os.path.join(
        os.path.dirname(os.path.abspath(input_path)), "output", "research.md"
    )

    try:
        with open(input_path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        print(f"Errore: file di input non trovato: {input_path}", file=sys.stderr)
        sys.exit(1)
    except json.JSONDecodeError as e:
        print(f"Errore: JSON non valido in {input_path}: {e}", file=sys.stderr)
        sys.exit(1)

    if not isinstance(data, dict) or "sources" not in data:
        print("Errore: il JSON deve contenere un campo 'sources'.", file=sys.stderr)
        sys.exit(1)

    note = build_note(data, n_keywords=args["keywords"], compare=args["compare"])

    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(note)

    print(f"Nota generata: {output_path} ({len(note)} caratteri)")


if __name__ == "__main__":
    main()

